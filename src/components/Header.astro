---
const navItems = [
  { label: "Casos", href: "#work" },
  { label: "Experiencia", href: "#experience" },
  { label: "Capacidades", href: "#capabilities" },
  { label: "Perfil", href: "#about" },
  { label: "Contacto", href: "#contact" },
];
---

<header class="header">
  <nav class="header__nav" aria-label="Navegación principal">
    <a class="header__brand" href="#home" aria-label="Ir al inicio">
      <span class="header__monogram" aria-hidden="true">JC</span>
      <span class="header__name">Jhon Castillo</span>
    </a>

    <button
      class="header__toggle"
      type="button"
      aria-label="Abrir menú"
      aria-controls="site-menu"
      aria-expanded="false"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <div class="header__menu" id="site-menu">
      <ul class="header__links">
        {
          navItems.map(({ href, label }) => (
            <li>
              <a class="header__link" href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
      <a
        class="header__cv"
        href="/pdf/JhonCarlosCastilloAtencio-cv.pdf"
        download
      >
        Descargar CV
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".header__toggle");
  const menu = document.querySelector<HTMLElement>(".header__menu");
  const links = document.querySelectorAll<HTMLAnchorElement>(".header__link");

  const setMenuOpen = (isOpen: boolean) => {
    menu?.classList.toggle("header__menu--open", isOpen);
    toggle?.classList.toggle("header__toggle--open", isOpen);
    toggle?.setAttribute("aria-expanded", String(isOpen));
    toggle?.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
  };

  toggle?.addEventListener("click", () => {
    setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  document
    .querySelectorAll<HTMLAnchorElement>(".header__menu a")
    .forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setMenuOpen(false);
      toggle?.focus();
    }
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((link) => {
          const isActive = link.getAttribute("href") === `#${entry.target.id}`;
          link.classList.toggle("header__link--active", isActive);
          if (isActive) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      });
    },
    { rootMargin: "-35% 0px -55% 0px" },
  );

  links.forEach((link) => {
    const target = document.querySelector(link.getAttribute("href") ?? "");
    if (target) observer.observe(target);
  });
</script>

<style>
  .header {
    position: sticky;
    z-index: var(--z-fixed);
    top: 0;
    border-bottom: 1px solid var(--border-color);
    background: rgba(16, 17, 25, 0.88);
    backdrop-filter: blur(18px);
  }

  .header__nav {
    display: flex;
    min-height: 4.5rem;
    width: min(calc(100% - 2rem), var(--container-width));
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
  }

  .header__monogram {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--border-color-strong);
    border-radius: var(--radius-sm);
    color: var(--primary-color);
    font-size: var(--text-sm);
    letter-spacing: -0.03em;
  }

  .header__name {
    display: none;
  }

  .header__toggle {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-content: center;
    gap: 0.35rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
  }

  .header__toggle span {
    width: 1.15rem;
    height: 1px;
    background: var(--text-color);
    transition: transform 200ms ease;
  }

  .header__toggle--open span:first-child {
    transform: translateY(0.2rem) rotate(45deg);
  }

  .header__toggle--open span:last-child {
    transform: translateY(-0.2rem) rotate(-45deg);
  }

  .header__menu {
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    display: none;
    width: 100%;
    padding: 1.25rem 1rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    background: var(--background-color-secondary);
  }

  .header__menu--open {
    display: block;
  }

  .header__links {
    display: grid;
    gap: 0.25rem;
  }

  .header__link {
    display: block;
    padding: 0.65rem 0;
    color: var(--text-color-secondary);
    font-size: var(--text-sm);
    transition: color 180ms ease;
  }

  .header__link:hover,
  .header__link--active {
    color: var(--text-color);
  }

  .header__cv {
    display: inline-flex;
    margin-top: 1rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border-color-strong);
    border-radius: var(--radius-sm);
    color: var(--primary-color);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .header__nav {
      width: min(calc(100% - 4rem), var(--container-width));
    }

    .header__name {
      display: inline;
    }

    .header__toggle {
      display: none;
    }

    .header__menu {
      position: static;
      display: flex;
      width: auto;
      padding: 0;
      align-items: center;
      gap: 1.5rem;
      border: 0;
      background: transparent;
    }

    .header__links {
      display: flex;
      align-items: center;
      gap: 1.4rem;
    }

    .header__link {
      position: relative;
      padding: 1.5rem 0;
    }

    .header__link::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 1.1rem;
      left: 0;
      height: 1px;
      transform: scaleX(0);
      background: var(--primary-color);
      transition: transform 180ms ease;
    }

    .header__link:hover::after,
    .header__link--active::after {
      transform: scaleX(1);
    }

    .header__cv {
      margin: 0;
      transition:
        border-color 180ms ease,
        background 180ms ease;
    }

    .header__cv:hover {
      border-color: var(--primary-color);
      background: var(--primary-color-soft);
    }
  }
</style>
