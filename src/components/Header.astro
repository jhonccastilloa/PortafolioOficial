---
const navItems = [
  { label: "Inicio", href: "#home" },
  { label: "Acerca de mí", href: "#about" },
  { label: "Habilidades", href: "#skill" },
  { label: "Estudios", href: "#study" },
  { label: "Servicios", href: "#service" },
  { label: "Mi portafolio", href: "#portfolio" },
  { label: "contacto", href: "#contact" },
];
---

<nav class="header__nav-container">
  <div class="header__nav">
    <figure class="header__logo">
      <img class="header__logo-vector" src="/vectores/Decor.svg" alt="" />
    </figure>
    <div class="header__menu">
      <a class="header__menu-btn--close"><i class="bx bx-x"></i></a>
      <ul class="header__nav-list">
        {
          navItems.map(({ href, label }) => (
            <li class="header__nav-item">
              <a class="header__nav-link " href={href}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <a class="header__menu-btn--open"><i class="bx bx-menu"></i></a>
  </div>
</nav>

<script>
  const btnMenu = document.querySelector(".header__menu-btn--open");
  const btnClose = document.querySelector(".header__menu-btn--close");
  const menu = document.querySelector(".header__menu");

  btnMenu?.addEventListener("click", () => {
    menu?.classList.add("header__menu--open");
  });
  btnClose?.addEventListener("click", () => {
    menu?.classList.remove("header__menu--open");
  });

  //------//

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute("id");
        const menuLink = document.querySelector(`.header__nav-list a[href="#${id}"]`);
        if (entry.isIntersecting) {
          let current = document.querySelector(".header__nav-link--active");
          current?.classList.remove("header__nav-link--active");
          menuLink?.classList.add("header__nav-link--active");
        }
      });
    },
    { rootMargin: "-35% 0px -65% 0px" },
  );

  const sections = document.querySelectorAll(".header__nav-link");
  for (let i = 0; i < sections.length; i++) {
    const hash = sections[i].getAttribute("href");
    if (hash) {
      const section = document.querySelector(hash);
      if (section) {
        observer.observe(section);
      }
    }
  }
</script>

<style>
  .header__nav-link {
    color: var(--text-color);
    font-size: var(--text-base);
  }
  .header__nav-item {
    margin-bottom: 16px;
    font-weight: 600;
  }
  .header__nav-container {
    width: 90%;
    max-width: 1380px;
    margin: auto;
  }
  .header__nav {
    top: 0;
    right: 0;
    z-index: var(--z-fixed);
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 2rem 0 0.5rem;
  }
  .header__logo {
    width: 100%;
    height: auto;
  }
  .header__logo-vector {
    width: 80px;
    height: auto;
  }
  .header__nav-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 1rem;
  }

  .header__menu-btn--close {
    position: absolute;
    right: 16px;
    top: 16px;
    background-color: var(--background-color-secondary);
    border-radius: 23px;
    width: 20px;
    height: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .header__menu-btn--open {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    z-index: 99;
    background-color: var(--background-color-secondary);
    border-radius: 23px;
    /* padding: 10px; */
  }

  .header__nav-link:hover {
    color: var(--primary-color);
    border-bottom: 1.5px solid var(--primary-color);
  }
  .header__nav-link--active {
    color: var(--primary-color);
    border-bottom: 1.5px solid var(--primary-color);
  }

  @media (max-width: 768px) {
    .header__menu {
      position: fixed;
      top: -100%;
      left: 0;
      width: 100%;
      padding: 2rem 1rem 1rem;
      background-color: var(--background-color);
      transition: 0.5s;
      z-index: var(--z-fixed);
      border-bottom: 2px solid var(--primary-color);
      border-radius: 0 0 22px 22px;
    }
    .header__menu--open {
      top: 0;
    }
  }
  @media (min-width: 768px) {
    .about__main {
      flex-direction: row;
    }

    .header__menu {
      align-items: flex-end;
      position: fixed;
      z-index: var(--z-fixed);
      background-color: var(--background-color);
      border-radius: 23px;
    }
    .header__menu-btn--close {
      display: none;
    }
    .header__logo-vector {
      width: 150px;
      height: auto;
    }

    .header__menu-btn--open {
      display: none;
    }
    .header__nav-list {
      height: 40px;
      flex-direction: row;
      justify-content: flex-end;
      font-weight: 400;
      align-items: center;
      text-align: center;
      gap: 30px;
      font-size: 14px;
      padding: 0 15px;
    }
    .header__nav-item {
      margin: 0;
    }
  }
</style>
