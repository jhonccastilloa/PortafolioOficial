---
import type { ContactLink } from "../interfaces/types";

const { href, label, value, external = false } = Astro.props as ContactLink;
---

<a
  class="contactItem"
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span class="contactItem__label">{label}</span>
  <span class="contactItem__value">{value}</span>
  <span class="contactItem__arrow" aria-hidden="true">↗</span>
</a>

<style>
  .contactItem {
    display: grid;
    padding-block: 1rem;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--border-color);
    transition: border-color 180ms ease;
  }

  .contactItem:hover {
    border-color: var(--primary-color);
  }

  .contactItem__label {
    color: var(--text-color-subtle);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .contactItem__value {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--text-color-secondary);
    font-size: var(--text-sm);
  }

  .contactItem__arrow {
    color: var(--primary-color);
  }
</style>
