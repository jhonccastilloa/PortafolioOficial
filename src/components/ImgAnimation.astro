---
import { Image } from "astro:assets";
import defaultImage from "../assets/images/default-image.avif";

interface Props {
  img: () => Promise<{
    default: ImageMetadata;
  }>;
  alt: string;
  class?: string;
}
const { alt, img, class: className, ...rest } = Astro.props;
---

<Image
  src={img?.() || defaultImage}
  class={`img-float ${className}`}
  alt={alt}
  loading="lazy"
  decoding="async"
  widths={[200, 256, 300]}
  sizes="(max-width: 768px) 200px, (max-width: 1024px) 256px, 300px"
  format="webp"
  {...rest}
/>

