---
import { Image } from "astro:assets";
import type { Technology } from "../interfaces/types";
import defaultImage from "../assets/images/default-image.avif";

interface Props {
  title: string;
  technologies: Technology[];
  linkRepository: string;
  linkExample?: string;
  img: string;
}

const { technologies, title, linkExample, linkRepository, img } = Astro.props;

const projectImages = import.meta.glob<{ default: ImageMetadata }>(
  `../assets/images/projects/*.png`,
);
const imgPath = `../assets/images/projects/${img}`;
---

<div class="portfolioItem-item">
  <figure class="portfolioItem-figure">
    <Image
      alt={title}
      src={projectImages[imgPath]() || defaultImage}
      class="portfolioItem-img"
      loading="lazy"
      decoding="async"
    />

    <div class="portfolioItem-info">
      <h4 class="portfolioItem-title">Hecho con:</h4>
      <ul class="portfolioItem-icon">
        {
          technologies.map(({ name, icon }) => (
            <li>
              <i class={`portfolioItem-technology bx ${icon}`} title={name} />
            </li>
          ))
        }
      </ul>
      <div class="portfolioItem-buttons">
        {
          linkExample ? (
            <a
              href={linkExample}
              target="_blank"
              class={`portfolio-link portfolio-link--reverse `}
            >
              Ver proyecto
              <i class="bx bx-link-external" />
            </a>
          ) : (
            <p class={`portfolio-link portfolio-link-hide`} />
          )
        }
        <a href={linkRepository} target="_blank" class="portfolio-link"
          ><i class="bx bxl-github"></i>Ver código</a
        >
      </div>
    </div>
  </figure>
  <h3 class="portfolioItem-subtitle">{title}</h3>
</div>

<style>
  .portfolioItem-item {
    padding-bottom: 45px;
    background-color: var(--background-color-secondary);
    box-shadow: 0 0 15px 2px #00000090;
    border-radius: 10px;
  }
  .portfolioItem-figure {
    position: relative;
    max-width: 325px;
    height: 282px;
    overflow: hidden;
    color: var(--text-color);
  }
  .portfolioItem-img {
    border-radius: 10px 10px 0 0;
  }
  .portfolio-link-hide {
    visibility: hidden;
  }
  .portfolioItem-item:hover .portfolioItem-info {
    bottom: 0;
    transition: bottom 500ms ease;
  }
  .portfolioItem-item:hover .portfolioItem-img {
    filter: blur(4px);
    transition: filter 500ms ease;
  }
  .portfolioItem-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    gap: 30px;
    width: 100%;
    height: 282px;
    padding: 6px;
    position: absolute;
    background-color: #1b1b1bb3;
    bottom: -100%;
    transition: bottom 500ms ease;
  }
  .portfolioItem-title {
    font-size: var(--text-2xl);
  }
  .portfolioItem-icon {
    display: flex;
    justify-content: space-evenly;
  }
  .portfolioItem-technology {
    font-size: 2.5rem;
    transition: transform 500ms ease;
  }
  .portfolioItem-technology:hover {
    transform: rotate(9deg);
    transition: transform 500ms ease;
  }

  .portfolioItem-buttons {
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .portfolio-link {
    display: flex;
    width: 145px;
    gap: 5px;
    position: relative;
    color: var(--text-color);
    background: var(--background-color);
    font-size: var(--text-sm);
    padding: 8px 15px;
    border-radius: 0 30px 30px 0;
    transition:
      box-shadow 0.5s ease,
      transform 0.5s ease;
  }
  .portfolio-link i {
    color: var(--text-color);
    font-size: var(--text-base);
    vertical-align: middle;
  }
  .portfolio-link--reverse {
    border-radius: 30px 0 0 30px;
    justify-content: flex-end;
  }
  .portfolio-link:hover {
    box-shadow: 5px 5px 20px #000c;
    transform: translateY(-3%);
    transition:
      box-shadow 0.5s ease,
      transform 0.5s ease;
  }
  .portfolioItem-subtitle {
    margin-top: 25px;
    text-align: center;
    color: var(--text-color);
    font-weight: 600;
  }
</style>
