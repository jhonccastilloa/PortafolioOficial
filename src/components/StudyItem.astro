---
import { Image } from "astro:assets";

interface Props {
  img: ImageMetadata;
  title: string;
  date: string;
}
const { date, img, title } = Astro.props;
---

<div class="studyItem">
  <figure class="studyItem-figure">
    <Image class="img-float" src={img} alt={title} loading="lazy" />
  </figure>
  <h3 class="studyItem-subtitle">{title}</h3>
  <p class="studyItem-paragraph">{date}</p>
</div>

<style>
  .studyItem {
    margin-bottom: 3.2rem;
    width: 16rem;
  }
  .studyItem-subtitle {
    color: var(--text-color);
    padding: 5px 0;
  }
  .studyItem-paragraph {
    color: var(--text-color-secondary);
    font-size: var(--text-base);
  }
  .studyItem-figure {
    display: flex;
    align-items: center;
    height: 208px;
    width: 163px;
    margin: 0 auto;
    filter: grayscale(100%);
    transition:
      transform 0.3s ease,
      filter 0.5s ease;
  }
  .studyItem-figure:hover {
    transform: scale(1.1);
    filter: grayscale(0);
  }
</style>
