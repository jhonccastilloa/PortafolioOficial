---
interface Props {
  id: string;
  isAlter?: boolean;
}
const { id, isAlter } = Astro.props;
---

<section class={`section ${isAlter && "section--alt"}`} id={id}>
  <slot />
</section>

<style>
  .section {
    padding-top: 40px;
    width: 90%;
    max-width: 1380px;
    margin: auto;
  }
  .section--alt {
    margin-bottom: 3.2rem;
    background-color: var(--background-color-secondary);
    border-radius: 10px;
  }
</style>
