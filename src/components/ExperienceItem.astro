---
import type { Experience } from "../interfaces/types";

const { company, position, period, description, technologies = [] } =
  Astro.props as Experience;
---

<article class="experienceItem">
  <div class="experienceItem__period">{period}</div>
  <div class="experienceItem__content">
    <p class="experienceItem__company">{company}</p>
    <h3 class="experienceItem__position">{position}</h3>
    <ul class="experienceItem__description">
      {description.map((item) => <li>{item}</li>)}
    </ul>
    {
      technologies.length > 0 && (
        <ul class="experienceItem__technologies" aria-label="Tecnologías">
          {technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      )
    }
  </div>
</article>

<style>
  .experienceItem {
    display: grid;
    padding-block: 2rem;
    gap: 0.85rem;
    border-top: 1px solid var(--border-color);
  }

  .experienceItem__period {
    color: var(--text-color-subtle);
    font-size: var(--text-sm);
  }

  .experienceItem__content {
    max-width: 48rem;
  }

  .experienceItem__company {
    margin-bottom: 0.25rem;
    color: var(--primary-color);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .experienceItem__position {
    font-size: clamp(1.25rem, 3vw, 1.65rem);
    line-height: 1.25;
  }

  .experienceItem__description {
    display: grid;
    margin-top: 1rem;
    gap: 0.5rem;
  }

  .experienceItem__description li {
    position: relative;
    padding-left: 1rem;
    color: var(--text-color-secondary);
  }

  .experienceItem__description li::before {
    content: "";
    position: absolute;
    top: 0.68rem;
    left: 0;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--primary-color);
  }

  .experienceItem__technologies {
    display: flex;
    margin-top: 1.25rem;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    color: var(--text-color-subtle);
    font-size: var(--text-xs);
  }

  @media (min-width: 768px) {
    .experienceItem {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
