---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href="https://jcastilloa.dhyrium.website/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content="Jhon Carlos Castillo Atencio | Web Developer Junior" />
    <meta name="description" content="Desarrollador full stack con bachiller en ingeniería de sistemas. Especialista en desarrollo web con conocimientos en HTML5, CSS3, JavaScript, TypeScript, ReactJS, PHP y GIT. Ofrezco servicios de desarrollo web y móvil personalizados." />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jcastilloa.dhyrium.website/" />
    <meta
      property="og:title"
      content="Jhon Carlos Castillo Atencio | Web Developer Junior"
    />
    <meta property="og:description" content="Desarrollador full stack con bachiller en ingeniería de sistemas. Especialista en desarrollo web con conocimientos en HTML5, CSS3, JavaScript, TypeScript, ReactJS, PHP y GIT. Ofrezco servicios de desarrollo web y móvil personalizados." />
    <meta
      property="og:image"
      content="https://jcastilloa.dhyrium.website/assets/logos-imagenes/preview.PNG"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://jcastilloa.dhyrium.website/" />
    <meta
      property="twitter:title"
      content="Jhon Carlos Castillo Atencio | Web Developer Junior"
    />
    <meta property="twitter:description" content="Desarrollador full stack con bachiller en ingeniería de sistemas. Especialista en desarrollo web con conocimientos en HTML5, CSS3, JavaScript, TypeScript, ReactJS, PHP y GIT. Ofrezco servicios de desarrollo web y móvil personalizados." />
    <meta
      property="twitter:image"
      content="https://jcastilloa.dhyrium.website/assets/logos-imagenes/preview.png"
    />
    <link
      rel="shortcut icon"
      href="/logos-imagenes/favi.png"
      type="image/x-icon"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Jhon Carlos Castillo Atencio",
        "jobTitle": "Web Developer Junior",
        "url": "https://jcastilloa.dhyrium.website/",
        "sameAs": [
          "https://github.com/jhonccastilloa",
          "https://www.linkedin.com/in/jhonccastilloa",
          "https://www.codewars.com/users/Castillo-SAN"
        ],
        "description": "Desarrollador full stack con bachiller en ingeniería de sistemas. Especialista en desarrollo web con conocimientos en HTML5, CSS3, JavaScript, TypeScript, ReactJS, PHP y GIT.",
        "knowsAbout": [
          "HTML5",
          "CSS3",
          "JavaScript",
          "TypeScript",
          "ReactJS",
          "PHP",
          "GIT",
          "Astro",
          "Desarrollo Web",
          "Desarrollo Móvil"
        ]
      }
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style is:global></style>
