---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="description"
      content="Desarrollador front end con conocimientos en HTML5, CSS3,
            JavaScript,TypeScript, ReactJS, PHP y GIT. Soy una persona proactiva
            con gran interés en el desarrollo web."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta
      name="title"
      content="Jhon Carlos Castillo Atencio | Web Developer Junior"
    />
    <meta
      name="description"
      content="Desarrollador front end con conocimientos en HTML5, CSS3,
                 JavaScript,TypeScript, ReactJS, PHP y GIT. Soy una persona proactiva
                 con gran interés en el desarrollo web."
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jcastilloa.ixstar.org/" />
    <meta
      property="og:title"
      content="Jhon Carlos Castillo Atencio | Web Developer Junior"
    />
    <meta
      property="og:description"
      content="Desarrollador front end con conocimientos en HTML5, CSS3,
                 JavaScript,TypeScript, ReactJS, PHP y GIT. Soy una persona proactiva
                 con gran interés en el desarrollo web."
    />
    <meta
      property="og:image"
      content="https://jcastilloa.ixstar.org/asset/logos-imagenes/preview.PNG"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://jcastilloa.ixstar.org/" />
    <meta
      property="twitter:title"
      content="Jhon Carlos Castillo Atencio | Web Developer Junior"
    />
    <meta
      property="twitter:description"
      content="Desarrollador front end con conocimientos en HTML5, CSS3,
                 JavaScript,TypeScript, ReactJS, PHP y GIT. Soy una persona proactiva
                 con gran interés en el desarrollo web."
    />
    <meta
      property="twitter:image"
      content="https://jcastilloa.ixstar.org/assets/logos-imagenes/preview.png"
    />
    <link
      rel="shortcut icon"
      href="/logos-imagenes/favi.png"
      type="image/x-icon"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="asset/css/style.css" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style is:global></style>
