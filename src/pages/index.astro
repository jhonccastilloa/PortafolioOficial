---
import "../styles/global.css";
import {
  About,
  Contact,
  Experience,
  Hero,
  Highlights,
  Portfolio,
  Skill,
} from "../sections";
import { SectionContainer } from "../components";
import Layout from "../layouts/Layout.astro";

const title = "Jhon Castillo | Frontend & Mobile Developer";
const description =
  "Frontend & Mobile Developer especializado en React, React Native, Angular y TypeScript, con experiencia en banca digital y productos empresariales.";
---

<Layout {title} {description}>
  <main>
    <SectionContainer id="home" isCompact>
      <Hero />
    </SectionContainer>
    <SectionContainer id="highlights" isCompact>
      <Highlights />
    </SectionContainer>
    <SectionContainer id="work">
      <Portfolio />
    </SectionContainer>
    <SectionContainer id="experience" isAlter>
      <Experience />
    </SectionContainer>
    <SectionContainer id="capabilities">
      <Skill />
    </SectionContainer>
    <SectionContainer id="about" isAlter>
      <About />
    </SectionContainer>
    <SectionContainer id="contact">
      <Contact />
    </SectionContainer>
  </main>
</Layout>
