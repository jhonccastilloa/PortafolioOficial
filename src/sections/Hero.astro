---
const focusAreas = [
  { label: "Mobile", value: "React Native · Android · iOS" },
  { label: "Frontend", value: "React · Angular · TypeScript" },
  { label: "Backend", value: "Express · Prisma · PostgreSQL" },
  { label: "Entrega", value: "Docker · Nginx · TLS · CI/CD" },
];
---

<div class="hero">
  <div class="hero__content">
    <p class="hero__eyebrow">Jhon Castillo · Frontend & Mobile Developer</p>
    <h1 class="hero__title">
      <span class="hero__title-line hero__title-line--primary">
        Productos web y móviles
      </span>
      <span class="hero__title-line">claros, seguros y</span>
      <span class="hero__title-line">listos para producción.</span>
    </h1>
    <p class="hero__description">
      Desarrollo experiencias con React, React Native, Angular y TypeScript.
      Mi enfoque está en banca digital, aplicaciones móviles y plataformas
      operativas. Complemento ese trabajo con APIs en Express y despliegues
      self-hosted con Docker y Nginx para llevar funcionalidades de principio
      a fin.
    </p>

    <div class="hero__actions">
      <a
        class="hero__button hero__button--primary"
        href="/pdf/JhonCarlosCastilloAtencio-cv.pdf"
        download
      >
        Descargar CV
        <span aria-hidden="true">↓</span>
      </a>
      <a class="hero__button" href="#work">Ver casos de estudio</a>
    </div>

    <div class="hero__links" aria-label="Perfiles profesionales">
      <a
        href="https://github.com/jhonccastilloa"
        target="_blank"
        rel="noopener noreferrer">GitHub ↗</a
      >
      <a
        href="https://www.linkedin.com/in/jccastilloa"
        target="_blank"
        rel="noopener noreferrer">LinkedIn ↗</a
      >
      <a href="mailto:jhoncarloscastilloatencio@gmail.com">Correo ↗</a>
    </div>
  </div>

  <aside class="hero__focus" aria-label="Especialización profesional">
    <p class="hero__focus-title">Especialización</p>
    <dl class="hero__focus-list">
      {
        focusAreas.map(({ label, value }) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </aside>
</div>

<style>
  .hero {
    display: grid;
    min-height: calc(100svh - 4.5rem - clamp(4rem, 10vw, 8rem));
    padding-block: 0;
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .hero__content {
    max-width: 48rem;
  }

  .hero__eyebrow {
    margin-bottom: 1.25rem;
    color: var(--primary-color);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__title {
    color: var(--text-color);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero__title-line {
    display: block;
    color: var(--text-color-secondary);
  }

  .hero__title-line--primary {
    color: var(--text-color);
  }

  .hero__description {
    max-width: 42rem;
    margin-top: 1.5rem;
    color: var(--text-color-secondary);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }

  .hero__actions {
    display: flex;
    margin-top: 2rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__button {
    display: inline-flex;
    min-height: 3rem;
    padding: 0.7rem 1rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-color-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      border-color 180ms ease,
      color 180ms ease,
      background 180ms ease;
  }

  .hero__button:hover {
    border-color: var(--border-color-strong);
    color: var(--text-color);
  }

  .hero__button--primary {
    border-color: var(--primary-color);
    background: var(--primary-color);
    color: var(--background-color);
  }

  .hero__button--primary:hover {
    background: var(--primary-color-strong);
    color: var(--background-color);
  }

  .hero__links {
    display: flex;
    margin-top: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--text-color-subtle);
    font-size: var(--text-sm);
  }

  .hero__links a {
    transition: color 180ms ease;
  }

  .hero__links a:hover {
    color: var(--primary-color);
  }

  .hero__focus {
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: rgba(25, 25, 35, 0.72);
  }

  .hero__focus-title {
    padding-bottom: 1rem;
    color: var(--text-color-subtle);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__focus-list div {
    display: grid;
    padding-block: 1rem;
    gap: 0.2rem;
    border-top: 1px solid var(--border-color);
  }

  .hero__focus-list dt {
    color: var(--primary-color);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .hero__focus-list dd {
    color: var(--text-color-secondary);
    font-size: var(--text-sm);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.75fr) minmax(17rem, 0.75fr);
    }

    .hero__title-line {
      white-space: nowrap;
    }
  }
</style>
