---
import { StudyItem } from "../components";
import logoUnap from '../assets/images/logo_UNAP.png';
import logoAcademlo from '../assets/images/logo_academlo.png';
const studies = [
  {
    img: logoUnap,
    title: "Universidad Nacional del Altiplano",
    date: "2017-2022",
  },
  { img: logoAcademlo, title: "Academlo", date: "2022-2023" },
];
---

<div class="studies">
  {
    studies.map(({ date, img, title }) => (
      <StudyItem date={date} img={img} title={title} />
    ))
  }
</div>

<style>
  .studies {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--padding-vertical);
  }
  @media (min-width: 768px) {
    .studies {
      flex-direction: row;
      justify-content: space-evenly;
    }
  }
</style>
