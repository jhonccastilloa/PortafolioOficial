---
import { ServiceItem } from "../components";

const servicesImagePath = "../assets/images/services";
const services = [
  {
    title: "Desarrollo Web",
    text: `Me especializo en la creación de interfaces modernas, 
    intuitivas y dinámicas, asegurando una experiencia de usuario atractiva y funcional en cada proyecto.`,
    imgPath: `${servicesImagePath}/web_development.png`,
  },
  {
    title: "Desarrollo Móvil",
    text: `Creo aplicaciones móviles de alto rendimiento, intuitivas y visualmente atractivas, enfocadas 
    en ofrecer la mejor experiencia de usuario en diversas plataformas.`,
    imgPath: `${servicesImagePath}/movil_development.png`,
  },
  {
    title: "Desarrollo Backend",
    text: `Diseño y desarrollo sistemas backend eficientes, escalables y seguros, encargándome de 
    la gestión de bases de datos, la lógica de negocio y la optimización del rendimiento para garantizar 
    un funcionamiento óptimo.`,
    imgPath: `${servicesImagePath}/back-end_development.png`,
  },
];
---

<div class="services">
  {services.map((section) => <ServiceItem {...section} />)}
</div>

<style>
  .services {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    padding: var(--padding-vertical);
  }
</style>
