---
import { CaseStudyItem, SectionHeading } from "../components";
import type { CaseStudy } from "../interfaces/types";

const cases: CaseStudy[] = [
  {
    eyebrow: "Bantotal · Experiencia profesional",
    title: "Banca digital para Latinoamérica",
    summary:
      "Desarrollo frontend y mobile en múltiples productos financieros, trabajando sobre flujos críticos de acceso, operaciones bancarias y publicación para Android e iOS.",
    role: "Desarrollador Mobile · React Native",
    period: "Feb 2023 — Actualidad",
    status: "Producción",
    highlights: [
      "Onboarding, login, recuperación de credenciales, 2FA y biometría.",
      "Transferencias, movimientos, wallet funding, DPF, pagos y recargas.",
      "SSL pinning, soft token, API 35, Fastlane, GitLab CI, Firebase y TestFlight.",
    ],
    technologies: [
      "React Native",
      "React",
      "TypeScript",
      "Redux",
      "Fastlane",
      "Angular",
    ],
    featured: true,
  },
  {
    eyebrow: "Producto mobile personal",
    title: "DebtMate",
    summary:
      "Aplicación Android de uso personal para registrar deudas, entender balances por contacto y mantener cuentas compartidas entre personas desde una experiencia simple.",
    role: "Diseño y desarrollo full stack",
    period: "2026 — Actualidad",
    status: "Uso personal",
    highlights: [
      "Registro de movimientos, balances individuales y evolución de deuda.",
      "Contactos, invitaciones y cuentas compartidas con reglas de participación.",
      "API REST con Express, Prisma y OpenAPI; distribución privada mediante Firebase.",
    ],
    technologies: [
      "React Native",
      "TypeScript",
      "React Query",
      "Zustand",
      "Express",
      "Prisma",
      "OpenAPI",
    ],
  },
  {
    eyebrow: "Proyecto independiente",
    title: "Plataforma de gestión de expedientes técnicos",
    summary:
      "Sistema empresarial en producción para coordinar expedientes, tareas, documentos y procesos administrativos con flujos especializados para equipos técnicos.",
    role: "Desarrollo full stack",
    period: "Jul 2023 — Actualidad",
    status: "Producción",
    highlights: [
      "Interfaces operativas para expedientes, tareas, planillas, asistencia y reuniones.",
      "Composición, foliación, impresión y exportación avanzada de documentos PDF.",
      "APIs Node.js, PostgreSQL y operación self-hosted con Docker, Nginx y TLS.",
    ],
    technologies: [
      "React",
      "TypeScript",
      "React Query",
      "Node.js",
      "PostgreSQL",
      "Docker",
      "Nginx",
    ],
  },
  {
    eyebrow: "Proyecto colaborativo",
    title: "Plataforma comercial y de posventa",
    summary:
      "Plantilla modular en desarrollo para automatizar ventas, inventario, caja, comprobantes electrónicos y atención posventa en futuras implementaciones empresariales.",
    role: "Liderazgo técnico y desarrollo full stack",
    period: "Oct 2025 — Actualidad",
    status: "En desarrollo",
    highlights: [
      "Catálogo, categorías, atributos, inventario, Kardex y operaciones de caja.",
      "Órdenes de servicio, diagnóstico, presupuesto, evidencias, garantía y entrega.",
      "API REST modular con Express y Prisma; comprobantes electrónicos en progreso.",
    ],
    technologies: [
      "React",
      "TypeScript",
      "TanStack Query",
      "Express",
      "Prisma",
      "Docker",
    ],
  },
];
---

<SectionHeading
  eyebrow="Trabajo seleccionado"
  title="Experiencia aplicada a productos reales"
  description="Casos resumidos sin exponer código, clientes ni información confidencial. El foco está en los problemas, el alcance y las decisiones técnicas."
/>

<div class="portfolio">
  {cases.map((caseStudy) => <CaseStudyItem {...caseStudy} />)}
</div>

<style>
  .portfolio {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 820px) {
    .portfolio {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
