---
import { ExperienceItem, SectionHeading } from "../components";
import type { Experience } from "../interfaces/types";

const experiences: Experience[] = [
  {
    company: "Bantotal",
    position: "Desarrollador Mobile · React Native",
    period: "Feb 2023 — Actualidad",
    description: [
      "Desarrollo de funcionalidades mobile y frontend para productos de banca digital en Latinoamérica.",
      "Implementación de autenticación, biometría, operaciones bancarias, seguridad móvil y correcciones de producción.",
      "Participación en releases Android/iOS y automatización con Fastlane, GitLab CI, Firebase y TestFlight.",
    ],
    technologies: [
      "React Native",
      "React",
      "TypeScript",
      "Redux",
      "Angular",
    ],
  },
  {
    company: "Desarrollo independiente",
    position: "Frontend, Mobile & Full Stack Developer",
    period: "Jul 2023 — Actualidad",
    description: [
      "Desarrollo y mantenimiento de una plataforma empresarial de expedientes técnicos utilizada en producción.",
      "Diseño de DebtMate, una aplicación Android personal con API REST propia para gestionar deudas y cuentas compartidas.",
      "Liderazgo técnico de una plantilla comercial y de posventa con frontend y backend modulares.",
      "Operación de infraestructura self-hosted y servidores VPS, con experiencia práctica en DigitalOcean y despliegues con Docker, Nginx, TLS, DNS, VPN, backups y recuperación de servicios.",
    ],
    technologies: [
      "React Native",
      "React",
      "Express",
      "Node.js",
      "Prisma",
      "PostgreSQL",
      "Docker",
      "Nginx",
    ],
  },
  {
    company: "Dirección Regional de Educación Puno",
    position: "Practicante en el Área de Informática",
    period: "2021 — 2022",
    description: [
      "Desarrollo de sistemas web para consulta de títulos, convocatorias y procesamiento de información administrativa.",
      "Soporte a sistemas internos, organización de datos y atención de requerimientos tecnológicos.",
    ],
    technologies: ["PHP", "MySQL", "JavaScript", "HTML", "CSS"],
  },
];
---

<SectionHeading
  eyebrow="Trayectoria"
  title="Experiencia profesional"
  description="Una evolución desde sistemas web administrativos hacia productos financieros móviles y plataformas empresariales completas."
/>

<div class="experience">
  {experiences.map((experience) => <ExperienceItem {...experience} />)}
</div>

<style>
  .experience {
    border-bottom: 1px solid var(--border-color);
  }
</style>
