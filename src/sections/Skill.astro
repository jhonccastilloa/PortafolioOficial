---
import { CapabilityGroup, SectionHeading } from "../components";
import type { Capability } from "../interfaces/types";

const capabilities: Capability[] = [
  {
    title: "Frontend web",
    description:
      "Construcción de interfaces escalables para operaciones complejas, con formularios, tablas, permisos, estados remotos y sistemas de diseño.",
    technologies: [
      "React",
      "TypeScript",
      "Astro",
      "React Query",
      "Redux",
      "Angular",
      "Accesibilidad",
    ],
    primary: true,
  },
  {
    title: "Desarrollo mobile",
    description:
      "Aplicaciones React Native con integraciones nativas, biometría, seguridad, navegación y ciclos de publicación para Android e iOS.",
    technologies: [
      "React Native",
      "Android",
      "iOS",
      "Biometría",
      "Fastlane",
      "Firebase",
    ],
    primary: true,
  },
  {
    title: "Backend y APIs",
    description:
      "Diseño de APIs REST, autenticación, validaciones y persistencia para sostener productos web y móviles de principio a fin.",
    technologies: [
      "Node.js",
      "Express",
      "Prisma",
      "PostgreSQL",
      "REST",
      "OpenAPI",
    ],
  },
  {
    title: "Infraestructura y despliegue",
    description:
      "Despliegue y operación de aplicaciones frontend y backend en infraestructura self-hosted y servidores VPS. Trabajo con Docker o despliegue directo en servidor, Nginx como proxy inverso, dominios, DNS, TLS, backups, monitoreo y recuperación.",
    technologies: [
      "VPS",
      "DigitalOcean",
      "Docker",
      "Nginx",
      "DNS",
      "TLS",
      "WireGuard",
      "Backups",
    ],
  },
];
---

<SectionHeading
  eyebrow="Capacidades"
  title="Especialización con visión integral"
  description="Frontend y mobile son el centro. Backend e infraestructura aportan la capacidad de llevar una funcionalidad desde la interfaz hasta su operación en producción."
/>

<div class="capabilities">
  {capabilities.map((capability) => <CapabilityGroup {...capability} />)}
</div>

<style>
  .capabilities {
    display: grid;
    border-bottom: 1px solid var(--border-color);
  }

  @media (min-width: 820px) {
    .capabilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .capabilities > :global(article:nth-child(even)) {
      border-left: 1px solid var(--border-color);
    }
  }
</style>
