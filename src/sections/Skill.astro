---
import { SkillRate } from "../components";
import { MySql, Npm, Postman, Express, AstroIcon } from "../components/icons";

const FRONT_END_SKILLS = [
  { name: "JavaScript", icon: "bxl-javascript" },
  { name: "TypeScript", icon: "bxl-typescript" },
  { name: "CSS 3", icon: "bxl-css3" },
  { name: "React JS", icon: "bxl-react" },
  { name: "React Native", icon: "bx-mobile-alt" },
  { name: "Redux", icon: "bxl-redux" },
  { name: "Angular", icon: "bxl-angular" },
  { name: "Astro", Icon: AstroIcon },
  { name: "HTML 5", icon: "bxl-html5" },
];
const BACK_END_SKILLS = [
  { name: "Node JS", icon: "bxl-nodejs" },
  { name: "Express JS", Icon: Express },
  { name: "PHP", icon: "bxl-php" },
  { name: "MySQL", Icon: MySql },
  { name: "PostgreSQL", icon: "bxl-postgresql" },
  { name: "Mongo DB", icon: "bxl-mongodb" },
];
const TOOLS = [
  { name: "GIT", icon: "bxl-git" },
  { name: "NPM", Icon: Npm },
  { name: "Postman", Icon: Postman },
  { name: "Docker", icon: "bxl-docker" },
];
---

<>
  <SkillRate skills={FRONT_END_SKILLS} subtitle="Fron End Development" />
  <SkillRate skills={BACK_END_SKILLS} subtitle="Back End Development" />
  <SkillRate skills={TOOLS} subtitle="Tools" />
</>
