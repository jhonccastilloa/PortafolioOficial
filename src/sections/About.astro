---
import { SectionHeading } from "../components";

const principles = [
  {
    title: "Claridad",
    text: "Interfaces que priorizan la tarea y reducen el ruido visual.",
  },
  {
    title: "Confiabilidad",
    text: "Atención a validaciones, estados, seguridad y escenarios reales.",
  },
  {
    title: "Autonomía",
    text: "Capacidad para avanzar desde la interfaz hasta la entrega técnica.",
  },
];
---

<SectionHeading eyebrow="Perfil" title="Ingeniero de Sistemas enfocado en producto" />

<div class="about">
  <div class="about__copy">
    <p>
      Soy Jhon Castillo, Ingeniero de Sistemas y desarrollador especializado en
      frontend y mobile. Trabajo principalmente con React y React Native en
      productos donde la experiencia, la seguridad y la estabilidad son parte
      esencial de la solución.
    </p>
    <p>
      Mi experiencia full stack me permite entender el sistema completo,
      colaborar mejor con otros equipos y resolver lo necesario para que una
      funcionalidad llegue a producción sin perder el foco en el usuario.
    </p>
  </div>

  <aside class="about__education">
    <p class="about__label">Formación</p>
    <h3>Ingeniero de Sistemas</h3>
    <p>Universidad Nacional del Altiplano</p>
    <span>2017 — 2022</span>
  </aside>
</div>

<ul class="about__principles">
  {
    principles.map(({ title, text }) => (
      <li>
        <strong>{title}</strong>
        <span>{text}</span>
      </li>
    ))
  }
</ul>

<style>
  .about {
    display: grid;
    gap: 2rem;
  }

  .about__copy {
    display: grid;
    max-width: 46rem;
    gap: 1rem;
    color: var(--text-color-secondary);
    font-size: var(--text-md);
  }

  .about__education {
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--background-color-secondary);
  }

  .about__label {
    margin-bottom: 1rem;
    color: var(--primary-color);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .about__education h3 {
    font-size: var(--text-lg);
  }

  .about__education p:not(.about__label),
  .about__education span {
    color: var(--text-color-secondary);
    font-size: var(--text-sm);
  }

  .about__principles {
    display: grid;
    margin-top: 3rem;
    border-block: 1px solid var(--border-color);
  }

  .about__principles li {
    display: grid;
    padding-block: 1rem;
    gap: 0.25rem;
  }

  .about__principles li + li {
    border-top: 1px solid var(--border-color);
  }

  .about__principles strong {
    font-size: var(--text-sm);
  }

  .about__principles span {
    color: var(--text-color-secondary);
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 0.7fr);
      align-items: start;
      gap: 4rem;
    }

    .about__principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about__principles li {
      padding: 1.25rem;
    }

    .about__principles li:first-child {
      padding-left: 0;
    }

    .about__principles li + li {
      border-top: 0;
      border-left: 1px solid var(--border-color);
    }
  }
</style>
