---
import type { Highlight } from "../interfaces/types";

const highlights: Highlight[] = [
  {
    value: "14+",
    label: "Aplicaciones financieras con participación profesional",
  },
  {
    value: "Android + iOS",
    label: "Desarrollo, seguridad y ciclos de entrega móvil",
  },
  {
    value: "End-to-end",
    label: "Web, mobile, APIs y despliegue self-hosted",
  },
];
---

<ul class="highlights" aria-label="Resumen de experiencia">
  {
    highlights.map(({ value, label }) => (
      <li class="highlights__item">
        <strong>{value}</strong>
        <span>{label}</span>
      </li>
    ))
  }
</ul>

<style>
  .highlights {
    display: grid;
    border-block: 1px solid var(--border-color);
  }

  .highlights__item {
    display: grid;
    padding-block: 1.35rem;
    gap: 0.25rem;
  }

  .highlights__item + .highlights__item {
    border-top: 1px solid var(--border-color);
  }

  .highlights__item strong {
    color: var(--text-color);
    font-size: var(--text-lg);
    letter-spacing: -0.025em;
  }

  .highlights__item span {
    max-width: 18rem;
    color: var(--text-color-secondary);
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .highlights {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .highlights__item {
      padding: 1.5rem;
    }

    .highlights__item:first-child {
      padding-left: 0;
    }

    .highlights__item + .highlights__item {
      border-top: 0;
      border-left: 1px solid var(--border-color);
    }
  }
</style>
